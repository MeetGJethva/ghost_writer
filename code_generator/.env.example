# .env.example – Copy to .env and fill in your values

# ── REQUIRED ──────────────────────────────────────────────────
# Groq API key (get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── OPTIONAL ──────────────────────────────────────────────────
# LLM model to use (default: llama3-70b-8192)
# Other Groq options: llama3-8b-8192, mixtral-8x7b-32768, gemma2-9b-it
LLM_MODEL=llama3-70b-8192

# Max ReAct iterations per agent (default: 20)
MAX_AGENT_ITERATIONS=20

# Default output directory for generated code (default: ./output)
OUTPUT_DIR=./output

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=LANGSMITH_PROJECT_name