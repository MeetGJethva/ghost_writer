# ── REQUIRED ──────────────────────────────────────────────────
# Groq API key (get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

OPENROUTER_API_KEY = your_open_router_api_key_here
# OPENROUTER_API_KEY = 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


LLM_MODEL=llama-3.3-70b-versatile
CODE_GENERATION_MODEL = qwen/qwen3.6-plus:free
# Max ReAct iterations per agent (default: 20)
MAX_AGENT_ITERATIONS=30

# Default output directory for generated code (default: ./output)
OUTPUT_DIR=./output

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_lang_smith_key_hear
LANGSMITH_PROJECT=project_name